NODE_ENV=development
PORT=5000

# Atlas connection string, include the database name /fitflow
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/fitflow?retryWrites=true&w=majority

# Each must be a random string of at least 32 characters
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=1d
METRICS_TOKEN=REPLACE_ME

# Exact origin of the frontend (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

LOG_LEVEL=debug

# Used only by "npm run seed:admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_ME

# Optional: use these DNS servers for the Atlas lookup (helps when your network breaks SRV queries)
DNS_SERVERS=
