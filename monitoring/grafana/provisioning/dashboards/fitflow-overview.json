{
  "uid": "fitflow-overview",
  "title": "FitFlow Overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "API up", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":4,"w":4,"x":0,"y":0},
      "targets": [{"refId":"A","expr":"min(up{job=\"fitflow-api\"})"}] },
    { "id": 2, "type": "stat", "title": "Database up", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":4,"w":4,"x":4,"y":0},
      "targets": [{"refId":"A","expr":"fitflow_db_up"}] },
    { "id": 3, "type": "stat", "title": "In-flight requests", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":4,"w":4,"x":8,"y":0},
      "targets": [{"refId":"A","expr":"http_requests_in_flight"}] },
    { "id": 4, "type": "stat", "title": "Failed logins (total)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":4,"w":4,"x":12,"y":0},
      "targets": [{"refId":"A","expr":"fitflow_auth_failures_total"}] },
    { "id": 5, "type": "stat", "title": "Uptime (minutes)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":4,"w":4,"x":16,"y":0},
      "targets": [{"refId":"A","expr":"process_uptime_seconds / 60"}] },

    { "id": 6, "type": "timeseries", "title": "Request rate by status (req/s)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":0,"y":4},
      "targets": [{"refId":"A","expr":"sum(rate(http_requests_total[1m])) by (status_code)","legendFormat":"{{status_code}}"}] },
    { "id": 7, "type": "timeseries", "title": "Error rate (5xx %)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":12,"y":4},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [{"refId":"A","expr":"sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))","legendFormat":"5xx"}] },
    { "id": 8, "type": "timeseries", "title": "Latency p50 / p95 / p99", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":0,"y":12},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId":"A","expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p50"},
        {"refId":"B","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95"},
        {"refId":"C","expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p99"}] },
    { "id": 9, "type": "timeseries", "title": "Requests by route (req/s)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":12,"y":12},
      "targets": [{"refId":"A","expr":"sum(rate(http_requests_total[1m])) by (route)","legendFormat":"{{route}}"}] },

    { "id": 10, "type": "timeseries", "title": "Memory (resident / heap used)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":0,"y":20},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"refId":"A","expr":"process_resident_memory_bytes","legendFormat":"resident"},
        {"refId":"B","expr":"nodejs_heap_size_used_bytes","legendFormat":"heap used"}] },
    { "id": 11, "type": "timeseries", "title": "Process CPU (cores)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":12,"y":20},
      "targets": [{"refId":"A","expr":"rate(process_cpu_seconds_total[1m])","legendFormat":"cpu"}] },
    { "id": 12, "type": "timeseries", "title": "Event loop lag", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":0,"y":28},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId":"A","expr":"nodejs_eventloop_lag_seconds","legendFormat":"lag"}] },
    { "id": 13, "type": "timeseries", "title": "Database ping latency p95", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":12,"y":28},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId":"A","expr":"histogram_quantile(0.95, sum(rate(fitflow_db_ping_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95"}] },

    { "id": 14, "type": "stat", "title": "Windows exporter up", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":4,"w":4,"x":0,"y":36},
      "targets": [{"refId":"A","expr":"min(up{job=\"windows\"})"}] },
    { "id": 15, "type": "timeseries", "title": "Windows CPU usage (%)", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":10,"x":4,"y":36},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "targets": [{"refId":"A","expr":"100 * (1 - avg by (instance) (rate(windows_cpu_time_total{mode=\"idle\"}[5m])))","legendFormat":"{{instance}}"}] },
    { "id": 16, "type": "timeseries", "title": "Available memory", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":10,"x":14,"y":36},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"refId":"A","expr":"windows_memory_available_bytes","legendFormat":"{{instance}}"}] },
    { "id": 17, "type": "timeseries", "title": "Logical disk free space", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":0,"y":44},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"refId":"A","expr":"windows_logical_disk_free_bytes{volume!=\"_Total\"}","legendFormat":"{{volume}} free"}] },
    { "id": 18, "type": "timeseries", "title": "Network traffic", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos": {"h":8,"w":12,"x":12,"y":44},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "targets": [
        {"refId":"A","expr":"rate(windows_net_bytes_received_total[5m])","legendFormat":"{{nic}} received"},
        {"refId":"B","expr":"rate(windows_net_bytes_sent_total[5m])","legendFormat":"{{nic}} sent"}] }
  ]
}