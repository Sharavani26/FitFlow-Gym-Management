# Copy this file to .env and replace both placeholders with different random secrets (32+ characters).
JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
METRICS_TOKEN=REPLACE_ME_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Defaults work for the included Docker Compose services.
MONGODB_URI=mongodb://mongo:27017/fitflow
CLIENT_ORIGIN=http://localhost:8080
JWT_EXPIRES_IN=1d
LOG_LEVEL=info
